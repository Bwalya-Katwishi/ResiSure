# Copy to EC2 as /home/ec2-user/resisure-secrets.env (never commit the filled file).
# Then run: bash scripts/ec2-harden-production.sh
#
# Only include variables you want to merge into apps/api/.env on the server.

# Cloudinary — https://cloudinary.com (free tier)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# SMTP — password reset and welcome emails
# Gmail: use App Password with 2FA enabled
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@yourdomain.com
SMTP_PASS=your_app_password
SMTP_FROM=ResiSure <noreply@yourdomain.com>

# Live payments (optional — remove ALLOW_MOCK_PAYMENTS when ready)
# ALLOW_MOCK_PAYMENTS=false
# PAYMENTS_WEBHOOK_SECRET=generate_a_long_random_string
# PAYMENT_PROVIDER=auto
# MTN_COLLECTION_SUBSCRIPTION_KEY=
# MTN_API_USER=
# MTN_API_KEY=
# MTN_TARGET_ENVIRONMENT=sandbox
# MTN_CALLBACK_URL=https://yourdomain.com/api/payments/webhooks/mtn
# AIRTEL_CLIENT_ID=
# AIRTEL_CLIENT_SECRET=
# AIRTEL_ENVIRONMENT=sandbox
