PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:5000
# true only for local/mobile. Production refuses to start if this is true.
CORS_ALLOW_ALL=false
TRUST_PROXY=false

DB_HOST=localhost
DB_PORT=5433
DB_NAME=resisure_db
DB_USER=postgres
DB_PASSWORD=your_password_here
# Or a single URL (used by many hosts):
# DATABASE_URL=postgres://user:pass@host:5432/resisure_db
# DB_SSL=true
# DB_SSL_REJECT_UNAUTHORIZED=false

JWT_SECRET=replace_with_a_long_random_string_min_32_chars
JWT_EXPIRES_IN=7d

# Optional — if unset, photos/docs are stored locally in apps/api/uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# mock | auto | mtn_momo | airtel_money | zamtel_kwacha
# auto routes by phone prefix when live credentials exist, otherwise mock (dev only).
PAYMENT_PROVIDER=auto
PAYMENT_SANDBOX=true
PAYMENTS_WEBHOOK_SECRET=
# Required in production if you keep the mock provider:
ALLOW_MOCK_PAYMENTS=true

# MTN MoMo Collection (live or sandbox)
MTN_COLLECTION_SUBSCRIPTION_KEY=
MTN_API_USER=
MTN_API_KEY=
MTN_TARGET_ENVIRONMENT=sandbox
MTN_BASE_URL=
MTN_CURRENCY=
MTN_CALLBACK_URL=

# Airtel Money Collection
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
AIRTEL_ENVIRONMENT=sandbox
AIRTEL_BASE_URL=
AIRTEL_COUNTRY=ZM
AIRTEL_CURRENCY=ZMW

# Zamtel Kwacha — merchant URL and credentials supplied by Zamtel commercial onboarding
# Not operational until ZAMTEL_COLLECTION_URL is provided by Zamtel.
ZAMTEL_COLLECTION_URL=
ZAMTEL_STATUS_URL=
ZAMTEL_THIRD_PARTY_ID=
ZAMTEL_PASSWORD=
ZAMTEL_SHORTCODE=
ZAMTEL_ENVIRONMENT=sandbox
ZAMTEL_WEBHOOK_SECRET=
ZAMTEL_CALLBACK_URL=

# Email (SMTP) — required for signup welcome emails and password reset
# Use the mailbox you created for ResiSure (e.g. noreply@yourdomain.com).
# Gmail / Google Workspace: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURE=false
#   Create an App Password if 2FA is enabled: https://myaccount.google.com/apppasswords
# Custom domain (cPanel, Zoho, etc.): use your provider's SMTP host and port.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=ResiSure <noreply@resisure.zm>

# SMS — Africa's Talking (preferred in Zambia) or Twilio
AT_USERNAME=
AT_API_KEY=
AT_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
