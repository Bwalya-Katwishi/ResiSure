# Copy to .env in the repo root before `docker compose up`.
# Never commit the filled file.

POSTGRES_DB=resisure_db
POSTGRES_USER=resisure
POSTGRES_PASSWORD=change_me_to_a_strong_password
POSTGRES_PORT=5432

JWT_SECRET=change_me_to_a_random_string_at_least_32_chars
JWT_EXPIRES_IN=7d

CLIENT_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:5000
NEXT_PUBLIC_API_URL=http://localhost:5000
API_PORT=5000
WEB_PORT=3000
TRUST_PROXY=true

# Demo hosts only. Remove both and set live MTN/Airtel/Zamtel credentials for real collections.
# mock | auto | mtn_momo | airtel_money | zamtel_kwacha
PAYMENT_PROVIDER=mock
ALLOW_MOCK_PAYMENTS=true
PAYMENT_SANDBOX=true
PAYMENTS_WEBHOOK_SECRET=
ALLOW_DEMO_SEED=false

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

MTN_COLLECTION_SUBSCRIPTION_KEY=
MTN_API_USER=
MTN_API_KEY=
MTN_TARGET_ENVIRONMENT=sandbox
MTN_CALLBACK_URL=

AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
AIRTEL_ENVIRONMENT=sandbox
AIRTEL_CURRENCY=ZMW

# Zamtel Kwacha — merchant URL and credentials supplied by Zamtel commercial onboarding
ZAMTEL_COLLECTION_URL=
ZAMTEL_STATUS_URL=
ZAMTEL_THIRD_PARTY_ID=
ZAMTEL_PASSWORD=
ZAMTEL_SHORTCODE=
ZAMTEL_ENVIRONMENT=sandbox
ZAMTEL_WEBHOOK_SECRET=
ZAMTEL_CALLBACK_URL=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=ResiSure <noreply@resisure.zm>
